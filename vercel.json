{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 300,
      "includeFiles": "{dashboard,engine.py,featurizer.py,log_parser.py,log_source.py,models.py,remote_sources.py,synthetic_logs.py}/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
